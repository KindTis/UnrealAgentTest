{
  "schema_version": 1,
  "source_text": "파란 표지판이 보이는 지점까지 이동하세요.",
  "language": "ko",
  "intent": "vision_navigation",
  "goal": {
    "description": "파란 표지판 근처 도착",
    "visual_target": "파란 표지판",
    "position_target": {
      "x": 1234.5,
      "y": -678.9,
      "tolerance_cm": 75
    }
  },
  "success_criteria": {
    "timeout_seconds": 240,
    "completion_state": "goal_reached",
    "success_mode": "hybrid"
  },
  "failure_criteria": {
    "input_failure_limit": 3,
    "capture_failure_limit": 1
  },
  "loop": {
    "max_iterations": 120,
    "observe_interval_seconds": 0.7,
    "capture_timeout_seconds": 2.0,
    "action_timeout_seconds": 3.0
  },
  "capture": {
    "height": 360,
    "preserve_aspect_ratio": true,
    "jpeg_quality": 60
  },
  "decision_bridge": {
    "mode": "file",
    "decide_wait_timeout_seconds": 30.0,
    "decide_retry_count": 1
  },
  "decision_policy": {
    "policy_version": 1,
    "mode": "strict",
    "target_missing": {
      "strategy": "scan_yaw",
      "scan_step_degrees": 45.0,
      "scan_duration_ms": 120,
      "wait_seconds": 0.0
    },
    "target_found": {
      "strategy": "success_after_wait",
      "success_wait_seconds": 1.0
    },
    "guardrails": {
      "require_image_observation": true,
      "max_actions_per_iteration": 3
    }
  },
  "termination": {
    "mode": "keep_running"
  }
}
